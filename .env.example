# GitHub personal access token used server-side to read the contribution calendar.
# Classic token needs no scopes for public contributions; a fine-grained token
# needs read-only "Public repositories" access. NEVER prefix this with VITE_ —
# anything VITE_-prefixed is inlined into the client bundle.
GITHUB_TOKEN=

# Profile whose contributions are rendered.
GITHUB_USERNAME=

# Port for the API server (the Vite dev proxy expects 8787).
PORT=8787

# Existing key used elsewhere in the app.
GEMINI_API_KEY=
